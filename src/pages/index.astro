---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import gruppen from '../data/gruppen.json';
import termine from '../data/termine.json';
import erfolge from '../data/erfolge.json';
import { url, formatDate } from '../lib/url';
import Foto from '../components/Foto.astro';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [top, ...rest] = news;
const side = rest.slice(0, 2);
const more = rest.slice(2, 5);
const jg = (j: number[]) => `${Math.min(...j)}–${Math.max(...j)}`;
// „wie im Sommer (ganzjährig gleich)" → eine Zeit für beide Saisons
const ganzjaehrig = (g: (typeof gruppen)[number]) => g.winter.startsWith('wie im Sommer');
const highlights = erfolge.filter((e) => e.highlight).slice(0, 3);
---
<Base>
  <div class="home">
  <div class="wrap" style="padding:0 12px">
    <section class="hero" aria-label="Willkommen">
      <Foto id="hero" class="dark">Hero-Foto · Gruppenbild der ganzen Crew im Stadion</Foto>
      <div class="hero-body">
        {top && <a class="hero-news" href={url(`/news/${top.id}/`)}><span class="tag-mono">NEU</span>{top.data.title} →</a>}
        <span style="font-size:clamp(16px,1.6vw,20px);font-weight:500;color:var(--soft-2)">Willkommen beim Sportverein</span>
        <h1>EAST SIDE<br />BERLIN</h1>
        <p>Dein Leichtathletikverein, in dem und mit dem du wachsen kannst – vom ersten Sprint bis zur Berliner Meisterschaft.</p>
        <div class="btn-row">
          <a href={url('/mitmachen/')} class="btn btn-neon">Passende Gruppe finden</a>
          <a href={url('/verein/')} class="btn btn-outline-light hide-mobile">Über uns</a>
        </div>
      </div>
    </section>
    <nav class="quicklinks" aria-label="Schnellzugriff">
      <a href="#gruppen"><strong>Trainings&shy;zeiten</strong><span>Alle Gruppen mit Jahrgang und Ort</span></a>
      <a href={url('/news/#termine')}><strong>Termine</strong><span>Wettkämpfe und Vereins&shy;termine</span></a>
      <a href={url('/erfolge/')}><strong>Erfolge</strong><span>Meistertitel, Pokale, Ergebnisse</span></a>
      <a href={url('/mitmachen/#anfrage')} class="is-neon"><strong>Probetraining</strong><span>Dreimal kostenlos testen</span></a>
    </nav>
  </div>

  <section class="wrap section home-news" id="news">
    <div class="section-head">
      <div><span class="eyebrow">News und Infos</span><h2 class="h-l">Aktuelles aus dem Verein</h2></div>
      <a href={url('/news/')} class="link-u tap">Alle Beiträge →</a>
    </div>
    <div class="news-feature">
      {top && (
        <a href={url(`/news/${top.id}/`)} class="card news-big">
          <Foto news={top.id}>
            Foto · {top.data.title}
            <div slot="over" class="badge-row"><span class="pill pill-neon">{top.data.kategorie}</span>{top.data.fotos && <span class="pill pill-dark">{top.data.fotos} Fotos</span>}</div>
          </Foto>
          <div class="card-body">
            <span class="meta">{formatDate(top.data.date)}</span>
            <h3>{top.data.title}</h3>
            <p class="lead">{top.data.teaser}</p>
            <strong style="margin-top:4px">Weiterlesen →</strong>
          </div>
        </a>
      )}
      <div class="news-side">
        {side.map((n, i) => (
          <a href={url(`/news/${n.id}/`)} class="news-row">
            <Foto news={n.id} class={i % 2 ? 'alt' : ''}>Foto</Foto>
            <div class="news-row-body">
              <span><span class={`pill ${n.data.kategorie === 'Erfolg' ? 'pill-neon' : 'pill-white'}`}>{n.data.kategorie}</span></span>
              <span class="meta">{formatDate(n.data.date)}</span>
              <h3>{n.data.title}</h3>
              {n.data.fotos && <span style="font-size:14px;font-weight:700;margin-top:auto">{n.data.fotos} Fotos · Weiterlesen →</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
    {more.length > 0 && (
      <div class="grid grid-3" style="margin-top:24px">
        {more.map((n) => (
          <a href={url(`/news/${n.id}/`)} class="card"><Foto news={n.id}>Foto</Foto><div class="card-body"><span class="meta">{formatDate(n.data.date)} · {n.data.kategorie}</span><h3 class="h-s">{n.data.title}</h3></div></a>
        ))}
      </div>
    )}
  </section>

  <section class="wrap section home-gruppen" id="gruppen">
    <div class="gruppen-termine">
      <div class="card-soft saison-aktuell">
        <div class="gruppen-head">
          <h2 class="h-m">Gruppen &amp; Trainings&shy;zeiten</h2>
          <span class="pill pill-white"><span class="s-sommer">Sommer · April–Oktober</span><span class="s-winter">Winter · November–März</span></span>
        </div>
        {gruppen.map((g) => (
          <a class="gruppe-row" href={url(`/mitmachen/?jahr=${Math.max(...g.jahrgaenge)}#ergebnis`)}>
            <span><strong>{g.name}</strong> <span class="muted nowrap">Jg. {jg(g.jahrgaenge)}</span></span>
            <span class={`pill ${g.status === 'frei' ? 'pill-neon' : 'pill-white'}`}>{g.status === 'frei' ? 'Plätze frei' : 'Warteliste'}</span>
            <span class="gruppe-zeit">{ganzjaehrig(g) ? g.sommer : <Fragment><span class="s-sommer">{g.sommer}</span><span class="s-winter">{g.winter}</span></Fragment>}</span>
          </a>
        ))}
        <p class="muted gruppen-hinweis">Gruppe voll? Auf die Warteliste setzen – oder als <a href={url('/trainer/')} class="link-u">Trainer:in</a> helfen, damit neue Gruppen entstehen. In den Schulferien kein Training.</p>
        <a href={url('/mitmachen/')} class="tap" style="font-weight:700">Zum Gruppenfinder →</a>
      </div>
      <div class="card-outline list-dates">
        <h3 class="h-m" style="margin-bottom:14px">Nächste Termine</h3>
        {termine.map((t) => <div class="list-row"><span class="date">{t.datum}</span><span>{t.titel}</span></div>)}
        <a href={url('/news/#termine')} class="tap" style="font-weight:700;margin-top:4px">Alle Termine →</a>
      </div>
    </div>
  </section>

  <section class="wrap section home-galerie">
    <div class="section-head">
      <h2 class="h-l">Momente aus Training und Wettkampf</h2>
      <a href="https://instagram.com/sc_eastside/" class="link-u tap">Mehr auf Instagram →</a>
    </div>
    <div class="gallery">
      <Foto id="galerie-staffel" class="alt big">Foto · Staffelübergabe</Foto>
      <Foto id="galerie-weitsprung">Foto · Weitsprung U10</Foto>
      <Foto id="galerie-aufwaermen" class="alt">Foto · Aufwärmen</Foto>
      <Foto id="galerie-camp" class="alt">Foto · Sportcamp</Foto>
      <Foto id="galerie-siegerehrung">Foto · Siegerehrung</Foto>
    </div>
  </section>

  <section class="wrap section home-angebot" id="angebot">
    <div class="section-head"><div><span class="eyebrow">Unser Angebot</span><h2 class="h-l">Für jedes Alter das Richtige</h2></div></div>
    <div class="grid grid-4 angebot-list">
      <a href={url('/mitmachen/dein-weg/')} class="card"><Foto id="angebot-kinder">Foto · U8/U10</Foto><div class="card-body"><span class="meta">Jg. 2015–2021</span><h3 class="h-s">Kinderleichtathletik</h3><p class="muted" style="flex-grow:1">Laufen, springen, werfen – spielerisch und vielseitig, U8 bis U12.</p><strong>Mehr →</strong></div></a>
      <a href={url('/mitmachen/dein-weg/')} class="card"><Foto id="angebot-schueler" class="alt">Foto · U14/U16</Foto><div class="card-body"><span class="meta">Jg. 2011–2014</span><h3 class="h-s">Schülerleichtathletik</h3><p class="muted" style="flex-grow:1">Strukturiertes Training und Wettkämpfe für alle, die mehr wollen.</p><strong>Mehr →</strong></div></a>
      <a href={url('/mitmachen/dein-weg/#spass')} class="card"><Foto id="angebot-spass">Foto · Spaß-Gruppe</Foto><div class="card-body"><span class="meta">Jg. 2012–2016</span><h3 class="h-s">Spaß-Gruppe</h3><p class="muted" style="flex-grow:1">Freude an Bewegung, ganz ohne Wettkampfehrgeiz.</p><strong>Mehr →</strong></div></a>
      <a href={url('/news/')} class="card"><Foto id="angebot-camp" class="alt">Foto · Camp</Foto><div class="card-body"><span class="meta">In den Ferien</span><h3 class="h-s">Sportcamps</h3><p class="muted" style="flex-grow:1">[Termine und Alter folgen]</p><strong>Mehr →</strong></div></a>
    </div>
  </section>

  <section class="wrap section home-erfolge">
    <div class="card-dark wins">
      <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
        <span class="pill pill-neon tag-mono">ERFOLGE</span>
        <h2 class="h-m" style="color:#fff">Hart trainiert. <span class="neon">Laut gefeiert.</span></h2>
        <a href={url('/erfolge/')} class="btn btn-neon">Alle Erfolge ansehen →</a>
      </div>
      <div class="wins-tiles">
        {highlights.map((e) => <div class="win-tile"><b>{e.platz}</b><span>{e.wettkampf} {e.klasse}</span></div>)}
      </div>
    </div>
  </section>

  <section class="wrap section home-partner" id="partner">
    <h2 class="h-s" style="margin-bottom:20px">Danke an unsere Partner</h2>
    <div class="partners"><div>[Logo]</div><div>[Logo]</div><div>[Logo]</div><div>[Logo]</div><div>[Logo]</div></div>
  </section>
  </div>
</Base>
