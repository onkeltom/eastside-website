---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import termine from '../../data/termine.json';
import { url, formatDate } from '../../lib/url';
import Foto from '../../components/Foto.astro';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="News & Termine" active="news">
  <section class="wrap page-head">
    <div style="display:flex;flex-direction:column;gap:18px;align-items:flex-start">
      <span class="pill pill-soft">News &amp; Termine</span>
      <h1 class="h-xl">Was gerade bei uns <span class="mark">los ist.</span></h1>
    </div>
    <p class="lead">Berichte von Wettkämpfen, Neuigkeiten aus dem Verein und alle wichtigen Termine.</p>
  </section>

  <section class="wrap section">
    <div class="grid grid-3">
      {news.map((n, i) => (
        <a href={url(`/news/${n.id}/`)} class="card">
          <Foto news={n.id} class={i % 2 ? 'alt' : ''}>
            Foto · {n.data.title}
            <div slot="over" class="badge-row"><span class={`pill ${n.data.kategorie === 'Erfolg' ? 'pill-neon' : 'pill-white'}`}>{n.data.kategorie}</span>{n.data.fotos && <span class="pill pill-dark">{n.data.fotos} Fotos</span>}</div>
          </Foto>
          <div class="card-body">
            <span class="meta">{formatDate(n.data.date)}</span>
            <h2 class="h-s">{n.data.title}</h2>
            <p class="muted">{n.data.teaser}</p>
            <strong style="margin-top:auto">Weiterlesen →</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" id="termine">
    <div class="card-outline list-dates" style="max-width:820px">
      <h2 class="h-m" style="margin-bottom:14px">Termine</h2>
      {termine.map((t) => <div class="list-row"><span class="date">{t.datum}</span><span>{t.titel}</span></div>)}
    </div>
  </section>
</Base>
