---
import Base from '../layouts/Base.astro';
import verein from '../data/verein.json';
import { url } from '../lib/url';
import ks from '../data/kinderschutz.json';
import beitraege from '../data/beitraege.json';
import partner from '../data/partner.json';
---
<Base title="Verein" active="verein">
  <section class="wrap page-head">
    <div style="display:flex;flex-direction:column;gap:18px;align-items:flex-start">
      <span class="pill pill-soft">Über uns</span>
      <h1 class="h-xl">Kleines Team mit <span class="mark">großem Herz.</span></h1>
    </div>
    <p class="lead">EAST SIDE BERLIN ist ein kleiner Familienverein, gegründet am {verein.gegruendet_am}. Wir fördern Sport, gesunde Gewohnheiten und einen aktiven Lebensstil – mit Schwerpunkt auf dem Kindersport. Bei uns können Kinder aktiv sein, Neues lernen, Spaß haben und Freundschaften schließen. Ob einfach bewegen oder Wettkämpfe: Unsere Türen sind für alle offen.</p>
  </section>

  <section class="wrap section grid grid-4">
    <div class="card-soft"><h2 class="h-s">Etwas für jeden</h2><p class="muted" style="margin-top:6px">Spiele, Wettkämpfe, Sportcamps und jede Menge Spaß – ob Spaß-Gruppe oder Berliner Meisterschaft.</p></div>
    <div class="card-soft"><h2 class="h-s">Ausgebildete Trainer:innen</h2><p class="muted" style="margin-top:6px">Langjährige Erfahrung in vielen Sportarten, Training angepasst an die Bedürfnisse der Kinder.</p></div>
    <div class="card-soft"><h2 class="h-s">Dreimal kostenlos testen</h2><p class="muted" style="margin-top:6px">Drei kostenlose Probetrainings und nur ein Monat Kündigungsfrist.</p></div>
    <div class="card-soft"><h2 class="h-s">Familienstimmung</h2><p class="muted" style="margin-top:6px">Wir sind ein kleiner Familienverein – und die Familie steht immer an erster Stelle.</p></div>
  </section>

  <section class="wrap section" id="team">
    <h2 class="h-l" style="margin-bottom:24px">Team &amp; Vorstand</h2>
    <div class="grid grid-4">
      {verein.team.map((p, i) => (
        <div class="card"><div class={`ph ${i % 2 ? 'alt' : ''}`}>Foto</div><div class="card-body"><h3 class="h-s">{p.name}</h3><p class="meta">{p.rolle}</p>{p.text && <p class="muted" style="font-size:15px">{p.text}</p>}</div></div>
      ))}
      {ks.ansprechpersonen.map((p, i) => (
        <a href={url('/kinderschutz/')} class="card"><div class={`ph ${i % 2 ? '' : 'alt'}`}>Foto</div><div class="card-body"><h3 class="h-s">{p.name}</h3><p class="meta">{p.rolle}</p><p class="muted" style="font-size:15px">{p.email}</p></div></a>
      ))}
    </div>
    <p class="muted" style="margin-top:16px">Kinderschutz ist bei uns Chefsache. <a href={url('/kinderschutz/')} class="link-u">Was wir dafür tun →</a></p>
    <div class="card-soft" style="margin-top:24px;display:flex;flex-wrap:wrap;gap:12px 32px;align-items:baseline">
      <h3 class="h-s">Vorstand</h3>
      {verein.vorstand.map((v) => <span><strong>{v.name}</strong> <span class="muted">· {v.rolle}</span></span>)}
      <a href={url('/verein/satzung/')} class="link-u tap" style="margin-left:auto">Satzung lesen →</a>
    </div>
  </section>

  <section class="wrap section" id="beitraege">
    <div class="card-outline" style="display:flex;flex-direction:column;gap:10px">
      <h2 class="h-m">Mitgliedschaft &amp; Beiträge</h2>
      <p class="muted">{beitraege.tarife[0].monat} im Monat ({beitraege.tarife[0].jahr} im Jahr), Geschwisterkinder {beitraege.tarife[1].monat}. Einmalig {beitraege.aufnahmegebuehr} Aufnahmegebühr, ein Monat Kündigungsfrist. Drei Probetrainings sind kostenlos.</p>
      <a href={url('/mitmachen/mitgliedschaft/')} class="link-u tap" style="align-self:flex-start">Beiträge &amp; Mitgliedsantrag →</a>
    </div>
  </section>

  <section class="wrap section" id="partner">
    <div class="card-dark grid grid-2" style="gap:28px">
      <div style="display:flex;flex-direction:column;gap:14px;align-items:flex-start">
        <span class="pill pill-neon">Partner &amp; Sponsoren</span>
        <h2 class="h-l" style="color:#fff">Werde Partner von EASTSIDE.</h2>
        <p>Mit eurer Unterstützung öffnen wir neue Gruppen, bilden Trainer:innen aus und bringen Kinder aus dem Kiez zu Wettkämpfen.</p>
        <a href={`mailto:${verein.email}?subject=Partnerschaft`} class="btn btn-neon">Kontakt aufnehmen →</a>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div class="win-tile"><span>[Partnerpaket 1: z. B. Trikotpartner]</span></div>
        <div class="win-tile"><span>[Partnerpaket 2: z. B. Camp-Partner]</span></div>
        <div class="win-tile"><span>[Partnerpaket 3: Material- oder Geldspende]</span></div>
      </div>
    </div>
    <h3 class="h-s" style="margin:28px 0 14px">Danke an unsere Freunde und Partner, die an unserer Seite stehen</h3>
    <div class="partners">{partner.map((p) => <a href={p.url}>{p.logo ? <img src={p.logo} alt={p.name} /> : p.name}</a>)}</div>
  </section>

  <section class="wrap section grid grid-2" style="align-items:start" id="spenden">
    <div class="card-soft" style="display:flex;flex-direction:column;gap:12px">
      <h2 class="h-m">Spenden</h2>
      <p>Egal ob klein oder groß, einmalig oder regelmäßig: Jede Spende hilft – und ist ein ganz persönlicher Beitrag für Kinder und Jugendliche.</p>
      <p class="muted">Schreib uns nach der Überweisung gern deine Kontaktdaten an <a href={`mailto:${verein.email}?subject=Spende`} class="link-u">{verein.email}</a>, damit wir uns bedanken und dir am Jahresende eine Spendenbescheinigung schicken können.</p>
      <p><strong>{verein.bank.inhaber}</strong><br />IBAN: {verein.bank.iban}<br />BIC: {verein.bank.bic}<br />{verein.bank.bank}</p>
    </div>
    <div class="card-outline" style="display:flex;flex-direction:column;gap:12px" id="vereinskleidung">
      <h2 class="h-m">Vereinskleidung</h2>
      <p class="muted">{verein.vereinskleidung.bestellen} {verein.vereinskleidung.hinweis}</p>
      {verein.vereinskleidung.artikel.map((a) => (
        <div class="list-row"><span><strong>{a.name}</strong>{a.groessen && <span class="muted" style="display:block;font-size:14px">Größen: {a.groessen}</span>}</span><span>{a.preis || '[Preis]'}</span></div>
      ))}
      <a href={`mailto:${verein.email}?subject=Vereinskleidung`} class="link-u tap">Per E-Mail bestellen →</a>
    </div>
  </section>

  <section class="wrap section" id="downloads">
    <div class="card-soft" style="display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center">
      <div><h2 class="h-s">Presse &amp; Downloads</h2><p class="muted"><a href={url('/verein/satzung/')} class="link-u">Satzung</a> · Beitragsordnung, Logos, Fotos für die Presse [Dateien folgen]</p></div>
      <a href={url('/erfolge/')} class="btn btn-outline">Erfolge ansehen</a>
    </div>
  </section>
</Base>
